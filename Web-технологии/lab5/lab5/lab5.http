@lab5_HostAddress = http://localhost:5182

### Список автомобилей
GET {{lab5_HostAddress}}/api/cars
Accept: application/json

### Создание автомобиля -> событие CREATE
POST {{lab5_HostAddress}}/api/cars
Content-Type: application/json

{
  "firm": "Toyota",
  "model": "Camry",
  "year": 2018,
  "power": 178,
  "color": "Red",
  "price": 25000,
  "dealerId": 1
}

### Изменение автомобиля -> событие UPDATE
PUT {{lab5_HostAddress}}/api/cars/1
Content-Type: application/json

{
  "firm": "Toyota",
  "model": "Camry",
  "year": 2018,
  "power": 181,
  "color": "White",
  "price": 26000,
  "dealerId": 1
}

### Удаление автомобиля -> событие DELETE
DELETE {{lab5_HostAddress}}/api/cars/72

###
