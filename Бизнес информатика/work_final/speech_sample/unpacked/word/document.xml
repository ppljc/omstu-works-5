<w:document xmlns:wpc="http://schemas.microsoft.com/office/word/2010/wordprocessingCanvas" xmlns:cx="http://schemas.microsoft.com/office/drawing/2014/chartex" xmlns:cx1="http://schemas.microsoft.com/office/drawing/2015/9/8/chartex" xmlns:cx2="http://schemas.microsoft.com/office/drawing/2015/10/21/chartex" xmlns:cx3="http://schemas.microsoft.com/office/drawing/2016/5/9/chartex" xmlns:cx4="http://schemas.microsoft.com/office/drawing/2016/5/10/chartex" xmlns:cx5="http://schemas.microsoft.com/office/drawing/2016/5/11/chartex" xmlns:cx6="http://schemas.microsoft.com/office/drawing/2016/5/12/chartex" xmlns:cx7="http://schemas.microsoft.com/office/drawing/2016/5/13/chartex" xmlns:cx8="http://schemas.microsoft.com/office/drawing/2016/5/14/chartex" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:aink="http://schemas.microsoft.com/office/drawing/2016/ink" xmlns:am3d="http://schemas.microsoft.com/office/drawing/2017/model3d" xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:oel="http://schemas.microsoft.com/office/2019/extlst" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" xmlns:m="http://schemas.openxmlformats.org/officeDocument/2006/math" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:wp14="http://schemas.microsoft.com/office/word/2010/wordprocessingDrawing" xmlns:wp="http://schemas.openxmlformats.org/drawingml/2006/wordprocessingDrawing" xmlns:w10="urn:schemas-microsoft-com:office:word" xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main" xmlns:w14="http://schemas.microsoft.com/office/word/2010/wordml" xmlns:w15="http://schemas.microsoft.com/office/word/2012/wordml" xmlns:w16cex="http://schemas.microsoft.com/office/word/2018/wordml/cex" xmlns:w16cid="http://schemas.microsoft.com/office/word/2016/wordml/cid" xmlns:w16="http://schemas.microsoft.com/office/word/2018/wordml" xmlns:w16du="http://schemas.microsoft.com/office/word/2023/wordml/word16du" xmlns:w16sdtdh="http://schemas.microsoft.com/office/word/2020/wordml/sdtdatahash" xmlns:w16sdtfl="http://schemas.microsoft.com/office/word/2024/wordml/sdtformatlock" xmlns:w16se="http://schemas.microsoft.com/office/word/2015/wordml/symex" xmlns:wpg="http://schemas.microsoft.com/office/word/2010/wordprocessingGroup" xmlns:wpi="http://schemas.microsoft.com/office/word/2010/wordprocessingInk" xmlns:wne="http://schemas.microsoft.com/office/word/2006/wordml" xmlns:wps="http://schemas.microsoft.com/office/word/2010/wordprocessingShape" mc:Ignorable="w14 w15 w16se w16cid w16 w16cex w16sdtdh w16sdtfl w16du wp14"><w:body><w:p w14:paraId="17591AB6" w14:textId="77777777" w:rsidR="00F01ADB" w:rsidRPr="00F01ADB" w:rsidRDefault="00F01ADB" w:rsidP="00F01ADB"><w:pPr><w:shd w:val="clear" w:color="auto" w:fill="FFFFFF"/><w:spacing w:before="480" w:after="240" w:line="360" w:lineRule="auto"/><w:ind w:firstLine="709"/><w:jc w:val="both"/><w:outlineLvl w:val="1"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman" w:cs="Times New Roman"/><w:b/><w:bCs/><w:color w:val="000000" w:themeColor="text1"/><w:kern w:val="0"/><w:sz w:val="28"/><w:szCs w:val="28"/><w:lang w:eastAsia="ru-RU"/><w14:ligatures w14:val="none"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman"/><w:b/><w:sz w:val="28"/></w:rPr><w:t>Вступление (20 секунд)</w:t></w:r></w:p><w:p w14:paraId="6A679C28" w14:textId="63D984C1" w:rsidR="00F01ADB" w:rsidRPr="00F01ADB" w:rsidRDefault="00F01ADB" w:rsidP="00F01ADB"><w:pPr><w:shd w:val="clear" w:color="auto" w:fill="FFFFFF"/><w:spacing w:before="240" w:after="240" w:line="360" w:lineRule="auto"/><w:ind w:firstLine="709"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman" w:cs="Times New Roman"/><w:color w:val="000000" w:themeColor="text1"/><w:kern w:val="0"/><w:sz w:val="28"/><w:szCs w:val="28"/><w:lang w:eastAsia="ru-RU"/><w14:ligatures w14:val="none"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman"/><w:b w:val="0"/><w:sz w:val="28"/></w:rPr><w:t>Уважаемая комиссия! Представляем FridgeChef — мобильное приложение, которое отвечает на ежедневный вопрос: что приготовить из того, что уже есть дома. Сервис объединяет рецепты, учёт продуктов, меню и покупки. Он помогает экономить время и деньги, а также сокращать пищевые отходы.</w:t></w:r></w:p><w:p w14:paraId="23DE98D4" w14:textId="77777777" w:rsidR="00F01ADB" w:rsidRPr="00F01ADB" w:rsidRDefault="00F01ADB" w:rsidP="00F01ADB"><w:pPr><w:shd w:val="clear" w:color="auto" w:fill="FFFFFF"/><w:spacing w:before="480" w:after="240" w:line="360" w:lineRule="auto"/><w:ind w:firstLine="709"/><w:jc w:val="both"/><w:outlineLvl w:val="1"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman" w:cs="Times New Roman"/><w:b/><w:bCs/><w:color w:val="000000" w:themeColor="text1"/><w:kern w:val="0"/><w:sz w:val="28"/><w:szCs w:val="28"/><w:lang w:eastAsia="ru-RU"/><w14:ligatures w14:val="none"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman"/><w:b/><w:sz w:val="28"/></w:rPr><w:t>Проблема (40 секунд)</w:t></w:r></w:p><w:p w14:paraId="7E3C8A9C" w14:textId="264ACFDD" w:rsidR="00F01ADB" w:rsidRPr="00F01ADB" w:rsidRDefault="00F01ADB" w:rsidP="00F01ADB"><w:pPr><w:shd w:val="clear" w:color="auto" w:fill="FFFFFF"/><w:spacing w:before="240" w:after="240" w:line="360" w:lineRule="auto"/><w:ind w:firstLine="709"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman" w:cs="Times New Roman"/><w:color w:val="000000" w:themeColor="text1"/><w:kern w:val="0"/><w:sz w:val="28"/><w:szCs w:val="28"/><w:lang w:eastAsia="ru-RU"/><w14:ligatures w14:val="none"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman"/><w:b w:val="0"/><w:sz w:val="28"/></w:rPr><w:t>Выбор блюда часто занимает не меньше времени, чем сама готовка. Пользователь просматривает рецепты, обнаруживает отсутствие ингредиентов и начинает поиск заново. Одновременно продукты в холодильнике забываются и портятся, а в магазине покупаются повторно.</w:t><w:br/><w:t>У занятых людей и начинающих кулинаров добавляются нехватка опыта и сложность планирования. Семьям нужно контролировать бюджет и составлять меню сразу на несколько человек. Существующие каталоги решают задачу по отдельности, но не связывают реальные запасы, сроки годности, меню и список покупок.</w:t></w:r></w:p><w:p w14:paraId="739E90CF" w14:textId="77777777" w:rsidR="00F01ADB" w:rsidRPr="00F01ADB" w:rsidRDefault="00F01ADB" w:rsidP="00F01ADB"><w:pPr><w:shd w:val="clear" w:color="auto" w:fill="FFFFFF"/><w:spacing w:before="480" w:after="240" w:line="360" w:lineRule="auto"/><w:ind w:firstLine="709"/><w:jc w:val="both"/><w:outlineLvl w:val="1"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman" w:cs="Times New Roman"/><w:b/><w:bCs/><w:color w:val="000000" w:themeColor="text1"/><w:kern w:val="0"/><w:sz w:val="28"/><w:szCs w:val="28"/><w:lang w:eastAsia="ru-RU"/><w14:ligatures w14:val="none"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman"/><w:b/><w:sz w:val="28"/></w:rPr><w:t>Решение (50 секунд)</w:t></w:r></w:p><w:p w14:paraId="25264512" w14:textId="77777777" w:rsidR="00F01ADB" w:rsidRPr="00F01ADB" w:rsidRDefault="00F01ADB" w:rsidP="00F01ADB"><w:pPr><w:shd w:val="clear" w:color="auto" w:fill="FFFFFF"/><w:spacing w:before="240" w:after="240" w:line="360" w:lineRule="auto"/><w:ind w:firstLine="709"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman" w:cs="Times New Roman"/><w:color w:val="000000" w:themeColor="text1"/><w:kern w:val="0"/><w:sz w:val="28"/><w:szCs w:val="28"/><w:lang w:eastAsia="ru-RU"/><w14:ligatures w14:val="none"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman"/><w:b w:val="0"/><w:sz w:val="28"/></w:rPr><w:t>FridgeChef объединяет весь цикл домашнего питания в одном сценарии. Пользователь добавляет продукты вручную или фотографирует их. Модель компьютерного зрения распознаёт позиции, а результат можно быстро исправить.</w:t><w:br/><w:t>Далее сервис подбирает рецепты по имеющимся ингредиентам, времени, сложности и ограничениям рациона. Приложение показывает пошаговую инструкцию и таймер. Выбранные блюда формируют меню на неделю, а недостающие продукты автоматически попадают в список покупок.</w:t></w:r></w:p><w:p w14:paraId="48347E5C" w14:textId="77777777" w:rsidR="00F01ADB" w:rsidRPr="00F01ADB" w:rsidRDefault="00F01ADB" w:rsidP="00F01ADB"><w:pPr><w:shd w:val="clear" w:color="auto" w:fill="FFFFFF"/><w:spacing w:before="240" w:after="240" w:line="360" w:lineRule="auto"/><w:ind w:firstLine="709"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman" w:cs="Times New Roman"/><w:color w:val="000000" w:themeColor="text1"/><w:kern w:val="0"/><w:sz w:val="28"/><w:szCs w:val="28"/><w:lang w:eastAsia="ru-RU"/><w14:ligatures w14:val="none"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman"/><w:b w:val="0"/><w:sz w:val="28"/></w:rPr><w:t>Напоминания о сроках годности помогают использовать запасы вовремя. В Premium доступны расширенное планирование, аналитика и персональные рекомендации. Так один сервис заменяет несколько разрозненных инструментов.</w:t></w:r></w:p><w:p w14:paraId="59D47C4C" w14:textId="77777777" w:rsidR="00F01ADB" w:rsidRPr="00F01ADB" w:rsidRDefault="00F01ADB" w:rsidP="00F01ADB"><w:pPr><w:shd w:val="clear" w:color="auto" w:fill="FFFFFF"/><w:spacing w:before="480" w:after="240" w:line="360" w:lineRule="auto"/><w:ind w:firstLine="709"/><w:jc w:val="both"/><w:outlineLvl w:val="1"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman" w:cs="Times New Roman"/><w:b/><w:bCs/><w:color w:val="000000" w:themeColor="text1"/><w:kern w:val="0"/><w:sz w:val="28"/><w:szCs w:val="28"/><w:lang w:eastAsia="ru-RU"/><w14:ligatures w14:val="none"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman"/><w:b/><w:sz w:val="28"/></w:rPr><w:t>Конкурентные преимущества (45 секунд)</w:t></w:r></w:p><w:p w14:paraId="47B1628D" w14:textId="77777777" w:rsidR="00F01ADB" w:rsidRPr="00F01ADB" w:rsidRDefault="00F01ADB" w:rsidP="00F01ADB"><w:pPr><w:shd w:val="clear" w:color="auto" w:fill="FFFFFF"/><w:spacing w:before="240" w:after="240" w:line="360" w:lineRule="auto"/><w:ind w:firstLine="709"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman" w:cs="Times New Roman"/><w:color w:val="000000" w:themeColor="text1"/><w:kern w:val="0"/><w:sz w:val="28"/><w:szCs w:val="28"/><w:lang w:eastAsia="ru-RU"/><w14:ligatures w14:val="none"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman"/><w:b w:val="0"/><w:sz w:val="28"/></w:rPr><w:t>Мы сравнили концепцию с Supercook, Cookpad и сервисом «Едим Дома» по шести критериям: цене, скорости, учёту продуктов и сроков, планированию, базе рецептов и удобству. FridgeChef получил сорок семь баллов из шестидесяти, Supercook — тридцать семь, «Едим Дома» — тридцать шесть, Cookpad — тридцать три.</w:t><w:br/><w:t>Главное отличие — полный цикл: от фотографии продуктов до готового блюда, меню и покупок. При этом мы честно видим зону роста: на старте наша база рецептов и сообщество будут меньше, поэтому развитие контента включено в дорожную карту.</w:t></w:r></w:p><w:p w14:paraId="2A16FAEB" w14:textId="77777777" w:rsidR="00F01ADB" w:rsidRDefault="00F01ADB" w:rsidP="00F01ADB"><w:pPr><w:shd w:val="clear" w:color="auto" w:fill="FFFFFF"/><w:spacing w:before="480" w:after="240" w:line="360" w:lineRule="auto"/><w:ind w:firstLine="709"/><w:jc w:val="both"/><w:outlineLvl w:val="1"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman" w:cs="Times New Roman"/><w:b/><w:bCs/><w:color w:val="000000" w:themeColor="text1"/><w:kern w:val="0"/><w:sz w:val="28"/><w:szCs w:val="28"/><w:lang w:eastAsia="ru-RU"/><w14:ligatures w14:val="none"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman"/><w:b w:val="0"/><w:sz w:val="28"/></w:rPr></w:r></w:p><w:p w14:paraId="5D32B08A" w14:textId="2AC6DCF2" w:rsidR="00F01ADB" w:rsidRPr="00F01ADB" w:rsidRDefault="00F01ADB" w:rsidP="00F01ADB"><w:pPr><w:shd w:val="clear" w:color="auto" w:fill="FFFFFF"/><w:spacing w:before="480" w:after="240" w:line="360" w:lineRule="auto"/><w:ind w:firstLine="709"/><w:jc w:val="both"/><w:outlineLvl w:val="1"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman" w:cs="Times New Roman"/><w:b/><w:bCs/><w:color w:val="000000" w:themeColor="text1"/><w:kern w:val="0"/><w:sz w:val="28"/><w:szCs w:val="28"/><w:lang w:eastAsia="ru-RU"/><w14:ligatures w14:val="none"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman"/><w:b/><w:sz w:val="28"/></w:rPr><w:t>Бизнес-модель и экономика (45 секунд)</w:t></w:r></w:p><w:p w14:paraId="7CAB76C5" w14:textId="77777777" w:rsidR="00F01ADB" w:rsidRPr="00F01ADB" w:rsidRDefault="00F01ADB" w:rsidP="00F01ADB"><w:pPr><w:shd w:val="clear" w:color="auto" w:fill="FFFFFF"/><w:spacing w:before="240" w:after="240" w:line="360" w:lineRule="auto"/><w:ind w:firstLine="709"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman" w:cs="Times New Roman"/><w:color w:val="000000" w:themeColor="text1"/><w:kern w:val="0"/><w:sz w:val="28"/><w:szCs w:val="28"/><w:lang w:eastAsia="ru-RU"/><w14:ligatures w14:val="none"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman"/><w:b w:val="0"/><w:sz w:val="28"/></w:rPr><w:t>Проект использует модель Freemium. Бесплатная версия даёт основной сценарий и формирует привычку. Premium стоит двести девяносто девять рублей в месяц и открывает расширенные функции. Дополнительные источники дохода — тематические подборки, комиссии партнёрских служб доставки и маркированные интеграции брендов.</w:t></w:r></w:p><w:p w14:paraId="58F85F32" w14:textId="77777777" w:rsidR="00F01ADB" w:rsidRPr="00F01ADB" w:rsidRDefault="00F01ADB" w:rsidP="00F01ADB"><w:pPr><w:shd w:val="clear" w:color="auto" w:fill="FFFFFF"/><w:spacing w:before="240" w:after="240" w:line="360" w:lineRule="auto"/><w:ind w:firstLine="709"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman" w:cs="Times New Roman"/><w:color w:val="000000" w:themeColor="text1"/><w:kern w:val="0"/><w:sz w:val="28"/><w:szCs w:val="28"/><w:lang w:eastAsia="ru-RU"/><w14:ligatures w14:val="none"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman"/><w:b w:val="0"/><w:sz w:val="28"/></w:rPr><w:t>Цель к концу две тысячи двадцать седьмого года — пять тысяч активных пользователей в месяц и двести пятьдесят Premium-подписок. Двести пятьдесят умножить на двести девяносто девять рублей даёт семьдесят четыре тысячи семьсот пятьдесят рублей ежемесячной регулярной выручки. Партнёрская монетизация подключается после роста активной аудитории, а смета и рентабельность уточняются по данным пилота.</w:t></w:r></w:p><w:p w14:paraId="14B71839" w14:textId="5EAE217A" w:rsidR="00F01ADB" w:rsidRPr="00F01ADB" w:rsidRDefault="00F01ADB" w:rsidP="00F01ADB"><w:pPr><w:shd w:val="clear" w:color="auto" w:fill="FFFFFF"/><w:spacing w:before="480" w:after="240" w:line="360" w:lineRule="auto"/><w:ind w:firstLine="709"/><w:jc w:val="both"/><w:outlineLvl w:val="1"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman" w:cs="Times New Roman"/><w:b/><w:bCs/><w:color w:val="000000" w:themeColor="text1"/><w:kern w:val="0"/><w:sz w:val="28"/><w:szCs w:val="28"/><w:lang w:eastAsia="ru-RU"/><w14:ligatures w14:val="none"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman"/><w:b/><w:sz w:val="28"/></w:rPr><w:t>Целевая аудитория и рынок (30 секунд)</w:t></w:r></w:p><w:p w14:paraId="720EB405" w14:textId="18C83677" w:rsidR="00F01ADB" w:rsidRPr="00F01ADB" w:rsidRDefault="00F01ADB" w:rsidP="00F01ADB"><w:pPr><w:shd w:val="clear" w:color="auto" w:fill="FFFFFF"/><w:spacing w:before="240" w:after="240" w:line="360" w:lineRule="auto"/><w:ind w:firstLine="709"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman" w:cs="Times New Roman"/><w:color w:val="000000" w:themeColor="text1"/><w:kern w:val="0"/><w:sz w:val="28"/><w:szCs w:val="28"/><w:lang w:eastAsia="ru-RU"/><w14:ligatures w14:val="none"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman"/><w:b w:val="0"/><w:sz w:val="28"/></w:rPr><w:t>Основная аудитория — занятые горожане, молодые специалисты, семьи и студенты, которые регулярно готовят дома. Отдельный сегмент — сторонники здорового питания и пользователи с особыми требованиями к рациону.</w:t><w:br/><w:t>Для них ценность понятна: меньше времени на выбор, меньше лишних покупок и выброшенных продуктов. B2B-сегмент включает службы доставки, онлайн-супермаркеты и бренды. Продвижение планируется через социальные сети, фуд-блогеров, RuStore, полезные уведомления и реферальную программу.</w:t></w:r></w:p><w:p w14:paraId="391D0D17" w14:textId="77777777" w:rsidR="00F01ADB" w:rsidRPr="00F01ADB" w:rsidRDefault="00F01ADB" w:rsidP="00F01ADB"><w:pPr><w:shd w:val="clear" w:color="auto" w:fill="FFFFFF"/><w:spacing w:before="480" w:after="240" w:line="360" w:lineRule="auto"/><w:ind w:firstLine="709"/><w:jc w:val="both"/><w:outlineLvl w:val="1"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman" w:cs="Times New Roman"/><w:b/><w:bCs/><w:color w:val="000000" w:themeColor="text1"/><w:kern w:val="0"/><w:sz w:val="28"/><w:szCs w:val="28"/><w:lang w:eastAsia="ru-RU"/><w14:ligatures w14:val="none"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman"/><w:b/><w:sz w:val="28"/></w:rPr><w:t>Состояние проекта и задел (30 секунд)</w:t></w:r></w:p><w:p w14:paraId="59E0D320" w14:textId="53DE3671" w:rsidR="00F01ADB" w:rsidRPr="00F01ADB" w:rsidRDefault="00F01ADB" w:rsidP="00F01ADB"><w:pPr><w:shd w:val="clear" w:color="auto" w:fill="FFFFFF"/><w:spacing w:before="240" w:after="240" w:line="360" w:lineRule="auto"/><w:ind w:firstLine="709"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman" w:cs="Times New Roman"/><w:color w:val="000000" w:themeColor="text1"/><w:kern w:val="0"/><w:sz w:val="28"/><w:szCs w:val="28"/><w:lang w:eastAsia="ru-RU"/><w14:ligatures w14:val="none"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman"/><w:b w:val="0"/><w:sz w:val="28"/></w:rPr><w:t>Сейчас проект находится на уровне технологической готовности TRL два–три. Сформулированы концепция и ценностное предложение, исследованы пользователь и конкуренты, построена канва бизнес-модели, выполнены PEST- и SWOT-анализ.</w:t><w:br/><w:t>Определены функции MVP, показатели эффективности и календарный план. SWOT показал преобладание наступательного потенциала: связка сильных сторон и возможностей набрала сто двадцать один балл. Следующий шаг — интерактивный прототип, техническая архитектура и проверка ключевых сценариев с пользователями.</w:t></w:r></w:p><w:p w14:paraId="2110638B" w14:textId="77777777" w:rsidR="00F01ADB" w:rsidRPr="00F01ADB" w:rsidRDefault="00F01ADB" w:rsidP="00F01ADB"><w:pPr><w:shd w:val="clear" w:color="auto" w:fill="FFFFFF"/><w:spacing w:before="480" w:after="240" w:line="360" w:lineRule="auto"/><w:ind w:firstLine="709"/><w:jc w:val="both"/><w:outlineLvl w:val="1"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman" w:cs="Times New Roman"/><w:b/><w:bCs/><w:color w:val="000000" w:themeColor="text1"/><w:kern w:val="0"/><w:sz w:val="28"/><w:szCs w:val="28"/><w:lang w:eastAsia="ru-RU"/><w14:ligatures w14:val="none"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman"/><w:b/><w:sz w:val="28"/></w:rPr><w:t>План реализации и показатели (40 секунд)</w:t></w:r></w:p><w:p w14:paraId="0CC79B13" w14:textId="77777777" w:rsidR="00F01ADB" w:rsidRPr="00F01ADB" w:rsidRDefault="00F01ADB" w:rsidP="00F01ADB"><w:pPr><w:shd w:val="clear" w:color="auto" w:fill="FFFFFF"/><w:spacing w:before="240" w:after="240" w:line="360" w:lineRule="auto"/><w:ind w:firstLine="709"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman" w:cs="Times New Roman"/><w:color w:val="000000" w:themeColor="text1"/><w:kern w:val="0"/><w:sz w:val="28"/><w:szCs w:val="28"/><w:lang w:eastAsia="ru-RU"/><w14:ligatures w14:val="none"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman"/><w:b w:val="0"/><w:sz w:val="28"/></w:rPr><w:t>В первом полугодии две тысячи двадцать седьмого года мы планируем создать UX/UI-прототип, архитектуру и MVP с базовым циклом, заложить защиту данных и подготовить первые пятьсот рецептов. До конца сентября база должна вырасти до тысячи рецептов, начнутся продвижение и тестирование тарифов.</w:t><w:br/><w:t>С августа по ноябрь подключаются Premium и две интеграции доставки. До декабря развиваются реферальная программа, поддержка и аналитика. Контрольные показатели: пять тысяч MAU, двести пятьдесят Premium-подписок, MRR семьдесят четыре тысячи семьсот пятьдесят рублей, удержание на тридцатый день не ниже тридцати процентов и CAC не более двухсот пятидесяти рублей.</w:t></w:r></w:p><w:p w14:paraId="49213060" w14:textId="77777777" w:rsidR="00F01ADB" w:rsidRPr="00F01ADB" w:rsidRDefault="00F01ADB" w:rsidP="00F01ADB"><w:pPr><w:shd w:val="clear" w:color="auto" w:fill="FFFFFF"/><w:spacing w:before="480" w:after="240" w:line="360" w:lineRule="auto"/><w:ind w:firstLine="709"/><w:jc w:val="both"/><w:outlineLvl w:val="1"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman" w:cs="Times New Roman"/><w:b/><w:bCs/><w:color w:val="000000" w:themeColor="text1"/><w:kern w:val="0"/><w:sz w:val="28"/><w:szCs w:val="28"/><w:lang w:eastAsia="ru-RU"/><w14:ligatures w14:val="none"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman"/><w:b/><w:sz w:val="28"/></w:rPr><w:t>Завершение (20 секунд)</w:t></w:r></w:p><w:p w14:paraId="1949BA81" w14:textId="77777777" w:rsidR="00F01ADB" w:rsidRPr="00F01ADB" w:rsidRDefault="00F01ADB" w:rsidP="00F01ADB"><w:pPr><w:shd w:val="clear" w:color="auto" w:fill="FFFFFF"/><w:spacing w:before="240" w:after="0" w:line="360" w:lineRule="auto"/><w:ind w:firstLine="709"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman" w:cs="Times New Roman"/><w:color w:val="000000" w:themeColor="text1"/><w:kern w:val="0"/><w:sz w:val="28"/><w:szCs w:val="28"/><w:lang w:eastAsia="ru-RU"/><w14:ligatures w14:val="none"/></w:rPr></w:pPr><w:r><w:rPr><w:rFonts w:ascii="Times New Roman" w:hAnsi="Times New Roman"/><w:b w:val="0"/><w:sz w:val="28"/></w:rPr><w:t>FridgeChef — это не просто каталог рецептов, а единый помощник домашнего питания. Он превращает имеющиеся продукты в понятный план: что приготовить, что купить и что использовать в первую очередь. Наша цель — сделать домашнюю готовку проще, экономнее и осознаннее. Спасибо за внимание! Готовы ответить на ваши вопросы.</w:t></w:r></w:p><w:p w14:paraId="3C84A25B" w14:textId="77777777" w:rsidR="00F01ADB" w:rsidRPr="00F01ADB" w:rsidRDefault="00F01ADB" w:rsidP="00F01ADB"><w:pPr><w:spacing w:after="0" w:line="360" w:lineRule="auto"/><w:ind w:firstLine="709"/><w:jc w:val="both"/><w:rPr><w:rFonts w:ascii="Times New Roman" w:eastAsia="Times New Roman" w:hAnsi="Times New Roman" w:cs="Times New Roman"/><w:color w:val="000000" w:themeColor="text1"/><w:kern w:val="0"/><w:sz w:val="28"/><w:szCs w:val="28"/><w:lang w:eastAsia="ru-RU"/><w14:ligatures w14:val="none"/></w:rPr></w:pPr></w:p><w:p w14:paraId="41CC5621" w14:textId="77777777" w:rsidR="00761857" w:rsidRDefault="00761857" w:rsidP="00F01ADB"><w:pPr><w:jc w:val="both"/></w:pPr></w:p><w:sectPr w:rsidR="00761857"><w:pgSz w:w="11906" w:h="16838"/><w:pgMar w:top="1134" w:right="850" w:bottom="1134" w:left="1701" w:header="708" w:footer="708" w:gutter="0"/><w:cols w:space="708"/><w:docGrid w:linePitch="360"/></w:sectPr></w:body></w:document>