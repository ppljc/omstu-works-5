l="24"/></w:rPr><w:t>Быстрые рецепты с пошаговыми инструкциями и таймером</w:t></w:r></w:p></w:tc></w:tr><w:tr w:rsidR="00E62C34" w14:paraId="673E0393" w14:textId="77777777"><w:tc><w:tcPr><w:tcW w:w="3000" w:type="dxa"/><w:tcMar><w:top w:w="100" w:type="dxa"/><w:left w:w="100" w:type="dxa"/><w:bottom w:w="100" w:type="dxa"/><w:right w:w="100" w:type="dxa"/></w:tcMar><w:vAlign w:val="center"/></w:tcPr><w:p w14:paraId="67A372AF" w14:textId="1283EFC5" w:rsidR="00E62C34" w:rsidRDefault="00ED3579" w:rsidP="00346CE4"><w:r><w:rPr><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr><w:t>Приготовить оригинальное блюдо</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="3400" w:type="dxa"/><w:tcMar><w:top w:w="100" w:type="dxa"/><w:left w:w="100" w:type="dxa"/><w:bottom w:w="100" w:type="dxa"/><w:right w:w="100" w:type="dxa"/></w:tcMar><w:vAlign w:val="center"/></w:tcPr><w:p w14:paraId="0473880F" w14:textId="79EA767F" w:rsidR="00E62C34" w:rsidRDefault="00ED3579" w:rsidP="00346CE4"><w:r><w:rPr><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr><w:t>Надоедают привычные блюда</w:t></w:r></w:p></w:tc><w:tc><w:tcPr><w:tcW w:w="3400" w:type="dxa"/><w:tcMar><w:top w:w="100" w:type="dxa"/><w:left w:w="100" w:type="dxa"/><w:bottom w:w="100" w:type="dxa"/><w:right w:w="100" w:type="dxa"/></w:tcMar><w:vAlign w:val="center"/></w:tcPr><w:p w14:paraId="5F374AD0" w14:textId="03F1322B" w:rsidR="00E62C34" w:rsidRDefault="00ED3579" w:rsidP="00346CE4"><w:r><w:rPr><w:sz w:val="24"/><w:szCs w:val="24"/></w:rPr><w:t>Разнообразие полезного питания</w:t></w:r></w:p></w:tc></w:tr></w:tbl><w:p w14:paraId="490030FC" w14:textId="66D3B396" w:rsidR="00ED3579" w:rsidRDefault="00ED3579" w:rsidP="00346CE4"><w:pPr><w:jc w:val="left"/><w:rPr><w:b/><w:szCs w:val="56"/></w:rPr></w:pPr></w:p><w:p w14:paraId="272F90D3" w14:textId="4A66964F" w:rsidR="0017571F" w:rsidRDefault="00ED3579" w:rsidP="00346CE4"><w:pPr><w:jc w:val="left"/><w:rPr><w:b/><w:szCs w:val="56"/></w:rPr></w:pPr><w:r><w:rPr><w:b/><w:szCs w:val="56"/></w:rPr><w:br w:type="page"/></w:r></w:p><w:p w14:paraId="386182C7" w14:textId="066E1AA0" w:rsidR="00E62C34" w:rsidRDefault="00000000" w:rsidP="00346CE4"><w:pPr><w:pStyle w:val="a3"/></w:pPr><w:r><w:lastRenderedPageBreak/><w:t>5 Выводы по анализу профиля пользователя</w:t></w:r></w:p><w:p w14:paraId="0FE2DE0B" w14:textId="747D0557" w:rsidR="00E62C34" w:rsidRDefault="00000000" w:rsidP="00346CE4"><w:r><w:t>На основе таблицы пользователя можно сделать следующие выводы:</w:t></w:r></w:p><w:p w14:paraId="0D6D05FE" w14:textId="58A9554A" w:rsidR="00E62C34" w:rsidRDefault="00000000" w:rsidP="00346CE4"><w:r><w:t>Ключевым барьером пользователя является нехватка времени и/или кулинарного опыта, из-за которой ежедневный вопрос «что приготовить» превращается в источник стресса. Основным мотивирующим фактором выступает экономия времени и денег: пользователь хочет быстрее принимать решение и меньше выбрасывать продуктов. Процесс взаимодействия с сервисом имеет определённую последовательность: проверка того, что есть дома, получение подходящих рецептов, приготовление блюда и, при необходимости, пополнение списка продуктов.</w:t></w:r></w:p><w:p w14:paraId="2A8BAB61" w14:textId="77777777" w:rsidR="00E62C34" w:rsidRDefault="00000000" w:rsidP="00346CE4"><w:pPr><w:pStyle w:val="a3"/></w:pPr><w:r><w:t>6 Составление и описание карты ценности (перечень сервисов/функционала, описание факторов помощи и факторов выгоды). Оформление в схематичном виде</w:t></w:r></w:p><w:p w14:paraId="333A11C9" w14:textId="77777777" w:rsidR="0041629D" w:rsidRDefault="00B64AEF" w:rsidP="00346CE4"><w:pPr><w:keepNext/><w:jc w:val="center"/></w:pPr><w:r><w:rPr><w:noProof/></w:rPr><w:drawing><wp:inline distT="0" distB="0" distL="0" distR="0" wp14:anchorId="1D671F41" wp14:editId="314EC715"><wp:extent cx="3576637" cy="3576637"/><wp:effectExtent l="0" t="0" r="5080" b="5080"/><wp:docPr id="6" name="Рисунок 6"/><wp:cNvGraphicFramePr><a:graphicFrameLocks xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" noChangeAspect="1"/></wp:cNvGraphicFramePr><a:graphic xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main"><a:graphicData uri="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:pic xmlns:pic="http://schemas.openxmlformats.org/drawingml/2006/picture"><pic:nvPicPr><pic:cNvPr id="0" name="Picture 3"/><pic:cNvPicPr><a:picLocks noChangeAspect="1" noChangeArrowheads="1"/></pic:cNvPicPr></pic:nvPicPr><pic:blipFill><a:blip r:embed="rId7" cstate="print"><a:extLst><a:ext uri="{28A0092B-C50C-407E-A947-70E740481C1C}"><a14:useLocalDpi xmlns:a14="http://schemas.microsoft.com/office/drawing/2010/main" val="0"/></a:ext></a:extLst></a:blip><a:srcRect/><a:stretch><a:fillRect/></a:stretch></pic:blipFill><pic:spPr bwMode="auto"><a:xfrm><a:off x="0" y="0"/><a:ext cx="3579000" cy="3579000"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom><a:noFill/><a:ln><a:noFill/></a:ln></pic:spPr></pic:pic></a:graphicData></a:graphic></wp:inline></w:drawing></w:r></w:p><w:p w14:paraId="1C8F029B" w14:textId="2B85BF5F" w:rsidR="00E62C34" w:rsidRPr="0041629D" w:rsidRDefault="0041629D" w:rsidP="00346CE4"><w:pPr><w:pStyle w:val="ac"/><w:spacing w:line="360" w:lineRule="auto"/><w:jc w:val="center"/><w:rPr><w:i w:val="0"/><w:iCs w:val="0"/><w:color w:val="auto"/><w:sz w:val="36"/><w:szCs w:val="36"/></w:rPr></w:pPr><w:r><w:rPr><w:i w:val="0"/><w:iCs w:val="0"/><w:color w:val="auto"/><w:sz w:val="28"/><w:szCs w:val="28"/></w:rPr><w:t xml:space="preserve">Рисунок </w:t></w:r><w:r><w:rPr><w:i w:val="0"/><w:iCs w:val="0"/><w:color w:val="auto"/><w:sz w:val="28"/><w:szCs w:val="28"/></w:rPr><w:fldChar w:fldCharType="begin"/></w:r><w:r><w:rPr><w:i w:val="0"/><w:iCs w:val="0"/><w:color w:val="auto"/><w:sz w:val="28"/><w:szCs w:val="28"/></w:rPr><w:instrText xml:space="preserve"> SEQ Рисунок \* ARABIC </w:instrText></w:r><w:r><w:rPr><w:i w:val="0"/><w:iCs w:val="0"/><w:color w:val="auto"/><w:sz w:val="28"/><w:szCs w:val="28"/></w:rPr><w:fldChar w:fldCharType="separate"/></w:r><w:r><w:rPr><w:i w:val="0"/><w:iCs w:val="0"/><w:noProof/><w:color w:val="auto"/><w:sz w:val="28"/><w:szCs w:val="28"/></w:rPr><w:t>2</w:t></w:r><w:r><w:rPr><w:i w:val="0"/><w:iCs w:val="0"/><w:color w:val="auto"/><w:sz w:val="28"/><w:szCs w:val="28"/></w:rPr><w:fldChar w:fldCharType="end"/></w:r><w:r><w:rPr><w:i w:val="0"/><w:iCs w:val="0"/><w:color w:val="auto"/><w:sz w:val="28"/><w:szCs w:val="28"/></w:rPr><w:t xml:space="preserve"> – Карта ценностей</w:t></w:r></w:p><w:p w14:paraId="1F145744" w14:textId="77777777" w:rsidR="0017571F" w:rsidRDefault="0017571F" w:rsidP="00346CE4"><w:pPr><w:jc w:val="left"/><w:rPr><w:b/><w:szCs w:val="56"/></w:rPr></w:pPr><w:r><w:br w:type="page"/></w:r></w:p><w:p w14:paraId="3563C096" w14:textId="176BD699" w:rsidR="00E62C34" w:rsidRDefault="00000000" w:rsidP="00346CE4"><w:pPr><w:pStyle w:val="a3"/></w:pPr><w:r><w:lastRenderedPageBreak/><w:t>7 Проверка на соответствие карты ценности и профиля пользователя</w:t></w:r></w:p><w:p w14:paraId="4EE010E2" w14:textId="77777777" w:rsidR="00E62C34" w:rsidRDefault="00000000" w:rsidP="00346CE4"><w:r><w:t>Данный цифровой продукт отвечает таким задачам пользователей, как быстрый подбор блюда из имеющихся продуктов и получение понятного пошагового рецепта, формируя факторы выгоды. Также он учитывает такие проблемы пользователей, как нехватка времени на планирование питания, недостаток кулинарного опыта и риск испортить продукты, не успев их использовать, формируя факторы помощи. Перечень услуг учитывает такие нюансы, как: распознавание продуктов по фото или их ручной ввод, база рецептов с фильтрами по сложности и времени приготовления, персональные рекомендации с учётом диетических ограничений, автоматический список покупок, напоминания об истекающем сроке годности продуктов, расчёт калорийности и стоимости блюда, сообщество пользователей с отзывами и рейтингом рецептов, а также планирование меню на неделю. Таким образом, можно сказать, что карта ценности соответствует профилям пользователей.</w:t></w:r></w:p><w:p w14:paraId="04F49881" w14:textId="77777777" w:rsidR="00E62C34" w:rsidRDefault="00000000" w:rsidP="00346CE4"><w:pPr><w:pStyle w:val="a3"/></w:pPr><w:r><w:t>8 Формулирование ценностного предложения, выводы о его востребованности/актуальности/значимости</w:t></w:r></w:p><w:p w14:paraId="368B3DA4" w14:textId="77777777" w:rsidR="00E62C34" w:rsidRDefault="00000000" w:rsidP="00346CE4"><w:r><w:t>На основе карты пользователя (занятого пользователя и начинающего кулинара) и карты ценности было сформулировано итоговое предложение: сервис, который помогает быстро понять, что приготовить из продуктов, уже имеющихся дома, экономя время, деньги и снижая количество выброшенной еды, независимо от уровня кулинарного опыта пользователя.</w:t></w:r></w:p><w:p w14:paraId="6CE9AA6C" w14:textId="77777777" w:rsidR="0041629D" w:rsidRDefault="0041629D" w:rsidP="00346CE4"><w:pPr><w:jc w:val="left"/></w:pPr><w:r><w:br w:type="page"/></w:r></w:p><w:p w14:paraId="16C89FF0" w14:textId="619359D2" w:rsidR="00E62C34" w:rsidRPr="0041629D" w:rsidRDefault="00000000" w:rsidP="00346CE4"><w:pPr><w:rPr><w:b/><w:bCs/></w:rPr></w:pPr><w:r><w:rPr><w:b/><w:bCs/></w:rPr><w:lastRenderedPageBreak/><w:t>Выводы о востребованности, актуальности, значимости:</w:t></w:r></w:p><w:p w14:paraId="29AC681F" w14:textId="77777777" w:rsidR="00E62C34" w:rsidRDefault="00000000" w:rsidP="00346CE4"><w:r><w:t>В условиях роста цен на продукты и всё большего внимания к осознанному потреблению вопрос рационального использования уже купленных продуктов становится особенно актуальным. Многие люди сталкиваются с тем, что часть купленной еды портится и выбрасывается просто потому, что не находится время или идея, как её использовать. Сервис напрямую решает эту проблему, что делает его востребованным.</w:t></w:r></w:p><w:p w14:paraId="56232E00" w14:textId="77777777" w:rsidR="00E62C34" w:rsidRDefault="00000000" w:rsidP="00346CE4"><w:r><w:t>Сервис удовлетворяет базовую потребность в быстром и понятном планировании питания. Он востребован сразу с двух сторон: занятых пользователей, которым важна скорость и удобство, и начинающих кулинаров, которым важны простота и поддержка. Выгода для обеих групп выражена чётко, что говорит о высоком потенциальном спросе.</w:t></w:r></w:p><w:p w14:paraId="1EA88D72" w14:textId="77777777" w:rsidR="00E62C34" w:rsidRDefault="00000000" w:rsidP="00346CE4"><w:r><w:t>Значимость проекта заключается не только в решении локальной задачи «что приготовить сегодня», но и в формировании более осознанной культуры потребления продуктов: снижении пищевых отходов, экономии семейного бюджета и постепенном развитии кулинарных навыков пользователей.</w:t></w:r></w:p><w:sectPr w:rsidR="00E62C34"><w:pgSz w:w="11906" w:h="16838"/><w:pgMar w:top="1440" w:right="1440" w:bottom="1440" w:left="1440" w:header="708" w:footer="708" w:gutter="0"/><w:cols w:space="720"/><w:docGrid w:linePitch="360"/></w:sectPr></w:body></w:document>